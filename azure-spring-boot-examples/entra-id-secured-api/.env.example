# Copy to ".env" or generate with create-entra-id-apps.ps1. Never commit ".env"!

# --- Java API configuration ---
TENANT_ID=00000000-0000-0000-0000-000000000000
API_CLIENT_ID=00000000-0000-0000-0000-000000000000
API_APP_ID_URI=api://00000000-0000-0000-0000-000000000000
# Comma separated list of client application ids allowed to call the API
ALLOWED_CLIENT_IDS=00000000-0000-0000-0000-000000000000

# --- invoke-api.ps1 configuration ---
API_URL=http://localhost:8080
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=<client secret>
NOT_ALLOWED_CLIENT_ID=00000000-0000-0000-0000-000000000000
NOT_ALLOWED_CLIENT_SECRET=<client secret>
