# Copy to .env and fill in your values. .env is git-ignored.
# Environment variables with the same name override values in this file.

# managed-identity (default) or user (signed-in Azure CLI user, for local testing)
AUTH_MODE=managed-identity

# Azure Database for PostgreSQL Flexible Server
PG_HOST=<server-name>.postgres.database.azure.com
PG_PORT=5432
PG_DATABASE=postgres

# User-assigned managed identity (AUTH_MODE=managed-identity)
# Name = PostgreSQL role created with pgaadauth_create_principal
MANAGED_IDENTITY_NAME=<managed-identity-name>
MANAGED_IDENTITY_CLIENT_ID=<managed-identity-client-id>

# Entra user (AUTH_MODE=user). Optional: defaults to the UPN of the signed-in az user.
# ENTRA_USER_NAME=<user>@<tenant>.onmicrosoft.com

# Demo behavior
QUERY_INTERVAL_SECONDS=10
# pool = HikariCP connection pool, new = new connection per query
CONNECTION_MODE=pool
POOL_MAX_LIFETIME_MINUTES=30
SHOW_TOKEN_INFO=true
